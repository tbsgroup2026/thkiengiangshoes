{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thkiengiangshoes",
  "main": "public/_worker.js",
  "account_id": "3b346f8398b8d1143acd52516011cfb4",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vpchuoiskechers",
      "database_id": "ae3a7efd-ff5d-45c2-8c49-78d1518e3aa1"
    }
  ],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://thkiengiangshoes.tbsgroup2026.workers.dev",
    "JWT_SECRET": "tbs_group_secure_jwt_secret_key_2026",
    // Địa chỉ gốc hệ thống tbsMayMoc (KHÔNG nhạy cảm — chỉ là URL, không phải khoá bí mật) — MMTB
    // (Tổ hợp Kiên Giang) proxy sang đây, xem handleMmtbKG() trong public/_worker.js. Chạy cục bộ
    // đè lại giá trị này bằng file .dev.vars (không commit) trỏ về http://localhost:3000.
    "TBSMAYMOC_API_URL": "https://tbs-may-moc-admin.tbs-quanlymaymoc.workers.dev"
  },
  "triggers": {
    "crons": [
      "0 8 * * 1"
    ]
  }
}
